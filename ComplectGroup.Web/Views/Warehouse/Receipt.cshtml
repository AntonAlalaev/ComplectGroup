@using ComplectGroup.Web.Models
@model ReceiptViewModel

@{
    ViewData["Title"] = "Приходование товара";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h4>📥 Приходование товара на склад</h4>
        </div>
        <div class="card-body">
            <form asp-action="Receipt" method="post" id="receiptForm">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="PartId" class="form-label">Деталь</label>

                    <!-- Фильтры выбора детали -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-5">
                            <label for="chapterFilter" class="form-label small text-muted mb-1">Раздел</label>
                            <select id="chapterFilter" class="form-select form-select-sm">
                                <option value="">Все разделы</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label for="partSearch" class="form-label small text-muted mb-1">Поиск по названию</label>
                            <input type="text" id="partSearch" class="form-control form-control-sm"
                                   placeholder="Начните вводить название детали..."
                                   autocomplete="off" />
                        </div>
                    </div>

                    <select asp-for="PartId" id="partSelect" class="form-control part-list" size="14" required>
                        <option value="">-- Выберите деталь --</option>
                        @foreach (var part in Model.Parts)
                        {
                            <option value="@part.Id"
                                    data-chapter-id="@part.Chapter.Id"
                                    data-chapter-name="@part.Chapter.Name"
                                    data-name="@part.Name">
                                [@part.Chapter.Name] @part.Name
                            </option>
                        }
                    </select>

                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <div id="partSearchInfo" class="form-text mb-0"></div>
                        <button type="button" id="resetPartFilters" class="btn btn-sm btn-link p-0">
                            Сбросить фильтры
                        </button>
                    </div>

                    <span asp-validation-for="PartId" class="invalid-feedback"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label">Количество (шт)</label>
                    <input asp-for="Quantity" type="number" class="form-control" min="1" required />
                    <span asp-validation-for="Quantity" class="invalid-feedback"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Примечания</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" 
                              placeholder="Номер документа, поставщик, и т.д." id="notesField"></textarea>
                    <span asp-validation-for="Notes" class="invalid-feedback"></span>
                    <div class="form-text">Оставьте пустым для автоматического заполнения</div>
                </div>

                <div class="mb-3">
                    <label asp-for="ReceiptDate" class="form-label">Дата приёмки</label>
                    <input asp-for="ReceiptDate" type="datetime-local" class="form-control" />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg" id="submitBtn">Принять товар</button>
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно для подтверждения -->
<div class="modal fade" id="notesModal" tabindex="-1" aria-labelledby="notesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="notesModalLabel">Поле "Примечания" не заполнено</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Вы хотите автоматически заполнить поле "Примечания" значением <strong>"Приход с упаковки"</strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelBtn" data-bs-dismiss="modal">Нет</button>
                <button type="button" class="btn btn-primary" id="confirmBtn">Да, заполнить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('receiptForm');
            const notesField = document.getElementById('notesField');
            const submitBtn = document.getElementById('submitBtn');
            const notesModal = new bootstrap.Modal(document.getElementById('notesModal'));
            
            let shouldSubmit = false;
            
            form.addEventListener('submit', function(event) {
                // Проверяем, нужно ли отправлять форму (после подтверждения в модальном окне)
                if (shouldSubmit) {
                    shouldSubmit = false;
                    return true; // Продолжаем отправку
                }
                
                // Получаем значение поля Notes, удаляем пробелы
                const notesValue = notesField.value.trim();
                
                // Проверяем стандартную валидацию формы
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                    form.classList.add('was-validated');
                    return false;
                }
                
                // Если поле Notes пустое, показываем модальное окно
                if (notesValue === '') {
                    event.preventDefault();
                    notesModal.show();
                    return false;
                }
                
                // Если поле заполнено, отправляем форму как обычно
                return true;
            });
            
            // Обработчик для кнопки "Да, заполнить"
            document.getElementById('confirmBtn').addEventListener('click', function() {
                // Заполняем поле значением по умолчанию
                notesField.value = 'Приход с упаковки';
                // Закрываем модальное окно
                notesModal.hide();
                // Устанавливаем флаг для отправки формы
                shouldSubmit = true;
                // Отправляем форму
                form.submit();
            });
            
            // Обработчик для кнопки "Нет"
            document.getElementById('cancelBtn').addEventListener('click', function() {
                notesModal.hide();
                // Устанавливаем фокус на поле Notes
                setTimeout(() => {
                    notesField.focus();
                    notesField.select();
                }, 300); // Небольшая задержка для плавности
            });
            
            // Закрытие модального окна по клику вне его
            document.getElementById('notesModal').addEventListener('hidden.bs.modal', function () {
                // При закрытии модального окна фокусируемся на поле Notes
                notesField.focus();
                notesField.select();
            });
            
            // Добавляем вспомогательную кнопку для быстрого заполнения
            const notesContainer = notesField.parentElement;
            const quickFillButton = document.createElement('button');
            quickFillButton.type = 'button';
            quickFillButton.className = 'btn btn-sm btn-outline-secondary mt-2';
            quickFillButton.textContent = '📦 Заполнить автоматически';
            quickFillButton.addEventListener('click', function() {
                notesField.value = 'Приход с упаковки';
                notesField.focus();
            });
            notesContainer.appendChild(quickFillButton);

            // ===== Фильтрация и поиск деталей =====
            const partSelect = document.getElementById('partSelect');
            const chapterFilter = document.getElementById('chapterFilter');
            const partSearch = document.getElementById('partSearch');
            const partSearchInfo = document.getElementById('partSearchInfo');
            const resetPartFilters = document.getElementById('resetPartFilters');

            if (partSelect && chapterFilter && partSearch) {
                // Исходный список деталей забираем из option'ов, отрисованных сервером
                const allParts = Array.from(partSelect.options)
                    .filter(option => option.value)
                    .map(option => ({
                        value: option.value,
                        name: option.dataset.name || '',
                        chapterId: option.dataset.chapterId || '',
                        chapterName: option.dataset.chapterName || ''
                    }));

                // Заполняем фильтр разделов (без дублей)
                const chapters = new Map();
                allParts.forEach(part => {
                    if (part.chapterId && !chapters.has(part.chapterId)) {
                        chapters.set(part.chapterId, part.chapterName);
                    }
                });

                Array.from(chapters.entries())
                    .sort((a, b) => a[1].localeCompare(b[1], 'ru'))
                    .forEach(([id, name]) => {
                        const option = document.createElement('option');
                        option.value = id;
                        option.textContent = name;
                        chapterFilter.appendChild(option);
                    });

                function renderFilteredParts() {
                    const chapterId = chapterFilter.value;
                    const query = partSearch.value.trim().toLowerCase();
                    const selectedValue = partSelect.value;

                    const filtered = allParts.filter(part => {
                        if (chapterId && part.chapterId !== chapterId) return false;
                        if (query && !part.name.toLowerCase().includes(query)) return false;
                        return true;
                    });

                    partSelect.innerHTML = '';

                    const placeholder = document.createElement('option');
                    placeholder.value = '';
                    placeholder.textContent = filtered.length > 0
                        ? '-- Выберите деталь --'
                        : '-- Ничего не найдено --';
                    partSelect.appendChild(placeholder);

                    filtered.forEach(part => {
                        const option = document.createElement('option');
                        option.value = part.value;
                        option.textContent = `[${part.chapterName}] ${part.name}`;
                        partSelect.appendChild(option);
                    });

                    // Сохраняем выбор, если деталь осталась в отфильтрованном списке
                    if (selectedValue && filtered.some(part => part.value === selectedValue)) {
                        partSelect.value = selectedValue;
                    }

                    partSearchInfo.textContent = filtered.length > 0
                        ? `Найдено деталей: ${filtered.length}`
                        : 'Детали не найдены. Измените раздел или поисковый запрос.';
                }

                chapterFilter.addEventListener('change', renderFilteredParts);
                partSearch.addEventListener('input', renderFilteredParts);

                // Enter в поиске выбирает первую найденную деталь, а не отправляет форму
                partSearch.addEventListener('keydown', function(event) {
                    if (event.key !== 'Enter') return;

                    event.preventDefault();
                    const firstPart = Array.from(partSelect.options).find(option => option.value);
                    if (firstPart) {
                        partSelect.value = firstPart.value;
                        partSelect.focus();
                    }
                });

                resetPartFilters.addEventListener('click', function() {
                    chapterFilter.value = '';
                    partSearch.value = '';
                    renderFilteredParts();
                    partSearch.focus();
                });

                // Первичная отрисовка (сохраняет выбранную деталь при ошибке валидации)
                renderFilteredParts();
            }
        });
    </script>
    
    <style>
        .form-text {
            font-size: 0.875rem;
            color: #6c757d;
            margin-top: 0.25rem;
        }

        /* Список деталей с прокруткой примерно на половину экрана */
        .part-list {
            height: 50vh;
            min-height: 280px;
            padding-right: 0.75rem;
            background-image: none;
        }

        .part-list option {
            padding: 0.35rem 0.5rem;
        }
        
        #notesModal .modal-body {
            font-size: 1.1rem;
            padding: 1.5rem;
        }
        
        #notesModal .modal-footer {
            padding: 1rem 1.5rem;
        }
        
        #notesModal .btn {
            min-width: 100px;
        }
    </style>
}