@using ComplectGroup.Web.Models
@model ComplectationReceiptViewModel

@{
    ViewData["Title"] = "Приходование по комплектации";
}

<h1>@ViewData["Title"]</h1>

<!-- Сообщения об ошибках/успехе -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Форма -->
<form method="post" id="receiptForm">
    @Html.AntiForgeryToken()

    <!-- Выбор комплектации -->
    <div class="mb-4">
        <label class="form-label"><strong>Выберите комплектацию:</strong></label>
        <div class="card">
            <div class="card-body">
                <div id="selectedComplectationDisplay" style="display: none;">
                    <div class="row align-items-center">
                        <div class="col-md-10">
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    <h5 class="mb-1" id="selectedComplectationNumber"></h5>
                                    <p class="text-muted mb-0" id="selectedComplectationCustomer"></p>
                                </div>
                                <div class="vr"></div>
                                <div>
                                    <div class="small text-muted">Дата отгрузки</div>
                                    <div class="fw-bold" id="selectedComplectationDate"></div>
                                </div>
                                <div class="vr"></div>
                                <div>
                                    <div class="small text-muted">Менеджер</div>
                                    <div class="fw-bold" id="selectedComplectationManager"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#complectationPickerModal">
                                🔍 Изменить
                            </button>
                        </div>
                    </div>
                </div>
                <div id="noComplectationSelected" class="text-center py-3">
                    <p class="text-muted mb-3">Комплектация не выбрана</p>
                    <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#complectationPickerModal">
                        🔍 Выбрать комплектацию
                    </button>
                </div>
                <!-- Скрытый input для хранения ID выбранной комплектации -->
                <input type="hidden" id="SelectedComplectationId" name="SelectedComplectationId" value="" />
            </div>
        </div>
    </div>

    <!-- Таблица позиций -->
    <div id="lineItemsContainer" style="display: none;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="text-muted small">
                Всего позиций: <strong id="positionsTotal">0</strong> ·
                Выбрано к приходованию: <strong id="positionsSelected">0</strong>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-success"
                        onclick="fillAllReceiptQuantities()"
                        title="Заполнить требуемым количеством все позиции. Приходование выполняется кнопкой «Оприходовать»">
                    <i class="fas fa-check-double"></i> Принять всё
                </button>
                <label for="lineItemsPageSize" class="form-label mb-0 small text-muted">Позиций на странице</label>
                <select id="lineItemsPageSize" class="form-select form-select-sm" style="width: auto;">
                    <option value="25">25</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                </select>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Раздел</th>
                        <th>Деталь</th>
                        <th class="text-center">Требуемо в комплектации</th>
                        <th class="text-center bg-info text-white">Уже отгружено</th>
                        <th class="text-center bg-success text-white">Есть на складе</th>
                        <th class="text-center">Оприходовать (кол-во)</th>
                    </tr>
                </thead>
                <tbody id="lineItemsBody">
                    <!-- Заполняется динамически -->
                </tbody>
            </table>
        </div>
        <nav class="mt-3" aria-label="Пагинация позиций">
            <ul class="pagination pagination-sm justify-content-center mb-0" id="lineItemsPagination"></ul>
        </nav>

        <!-- Скрытые поля, которые реально уходят на сервер (только позиции с количеством > 0) -->
        <div id="receiptPayload"></div>

        <!-- Кнопка -->
        <div class="mt-4">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="fas fa-check-circle"></i> Оприходовать
            </button>
            <a href="@Url.Action("Index", "Warehouse")" class="btn btn-secondary btn-lg">
                <i class="fas fa-times-circle"></i> Отмена
            </a>
        </div>
    </div>
</form>

<!-- Подключение модального окна выбора комплектации -->
@await Html.PartialAsync("_WarehouseComplectationPicker")

<!-- JavaScript для загрузки позиций -->
<script>
    // Глобальные переменные для хранения состояния
    let pickerState = {
        pageNumber: 1,
        pageSize: 20,
        selectedId: null,
        items: []
    };

    let searchTimeout = null;

    // Debounce для поиска (задержка 300мс)
    function debounceSearch() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(searchComplectations, 300);
    }

    // Применение пресета
    function applyPreset(preset) {
        // Сброс всех фильтров
        document.getElementById('filterNumber').value = '';
        document.getElementById('filterCustomer').value = '';
        document.getElementById('filterManager').value = '';
        document.getElementById('filterStatus').value = '';
        document.getElementById('filterDateFrom').value = '';
        document.getElementById('filterDateTo').value = '';

        // Установка пресета
        const today = new Date().toISOString().split('T')[0];

        switch(preset) {
            case 'today':
                document.getElementById('filterDateFrom').value = today;
                document.getElementById('filterDateTo').value = today;
                break;
            case 'week':
                const startOfWeek = getStartOfWeek(new Date());
                document.getElementById('filterDateFrom').value = startOfWeek;
                document.getElementById('filterDateTo').value = today;
                break;
            case 'month':
                const startOfMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString().split('T')[0];
                document.getElementById('filterDateFrom').value = startOfMonth;
                document.getElementById('filterDateTo').value = today;
                break;
            case 'draft':
                document.getElementById('filterStatus').value = '0';
                break;
            case 'shipped':
                document.getElementById('filterStatus').value = '2';
                break;
        }

        searchComplectations();
    }

    // Получить начало недели (понедельник)
    function getStartOfWeek(date) {
        const day = date.getDay();
        const diff = date.getDate() - day + (day === 0 ? -6 : 1);
        return new Date(date.setDate(diff)).toISOString().split('T')[0];
    }

    // Сброс фильтров
    function resetFilters() {
        document.getElementById('filterNumber').value = '';
        document.getElementById('filterCustomer').value = '';
        document.getElementById('filterManager').value = '';
        document.getElementById('filterStatus').value = '';
        document.getElementById('filterDateFrom').value = '';
        document.getElementById('filterDateTo').value = '';
        document.getElementById('filterPageSize').value = '20';
        pickerState.pageNumber = 1;
        pickerState.pageSize = 20;
        searchComplectations();
    }

    // Поиск комплектаций
    async function searchComplectations() {
        pickerState.pageSize = parseInt(document.getElementById('filterPageSize').value);

        const params = new URLSearchParams({
            pageNumber: pickerState.pageNumber.toString(),
            pageSize: pickerState.pageSize.toString(),
            searchNumber: document.getElementById('filterNumber').value || '',
            searchCustomer: document.getElementById('filterCustomer').value || '',
            searchManager: document.getElementById('filterManager').value || '',
            status: document.getElementById('filterStatus').value || '',
            dateFrom: document.getElementById('filterDateFrom').value || '',
            dateTo: document.getElementById('filterDateTo').value || ''
        });

        const url = `/api/complectations/search?${params}`;
        console.log('API запрос:', url);

        try {
            const response = await fetch(url);
            console.log('Статус ответа:', response.status);

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();
            console.log('Получены данные:', data);

            renderResults(data);
            renderPagination(data);
            document.getElementById('totalCount').textContent = data.totalCount;
        } catch (error) {
            console.error('Ошибка поиска:', error);
            document.getElementById('pickerResults').innerHTML = `
                <tr>
                    <td colspan="8" class="text-center text-danger py-4">
                        ❌ Ошибка загрузки данных: ${error.message}
                    </td>
                </tr>
            `;
        }
    }

    // Отрисовка результатов
    function renderResults(data) {
        const tbody = document.getElementById('pickerResults');
        pickerState.items = data.items;

        if (data.items.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        😕 Ничего не найдено
                    </td>
                </tr>
            `;
            return;
        }

        const statusLabels = {
            0: { text: '📝 Черновик', class: 'bg-warning text-dark' },
            1: { text: '📦 Частично', class: 'bg-info text-white' },
            2: { text: '✅ Отгружена', class: 'bg-success text-white' },
            3: { text: '🗄️ Архив', class: 'bg-secondary text-white' }
        };

        tbody.innerHTML = data.items.map(item => {
            const status = statusLabels[item.status] || statusLabels[0];
            const isSelected = item.id === pickerState.selectedId;
            const rowClass = isSelected ? 'table-primary' : '';

            return `
                <tr class="${rowClass}" style="cursor: pointer;" onclick="selectComplectation(${item.id})">
                    <td><strong>${escapeHtml(item.number)}</strong></td>
                    <td>${escapeHtml(item.customer || '—')}</td>
                    <td>${escapeHtml(item.manager || '—')}</td>
                    <td>${formatDate(item.shippingDate)}</td>
                    <td class="text-center"><span class="badge ${status.class}">${status.text}</span></td>
                    <td class="text-center">${item.positions?.length || 0}</td>
                    <td class="text-end">${item.totalWeight?.toFixed(0) || 0}</td>
                    <td class="text-end">${item.totalVolume?.toFixed(2) || 0}</td>
                </tr>
            `;
        }).join('');
    }

    // Отрисовка пагинации
    function renderPagination(data) {
        const pagination = document.getElementById('pickerPagination');

        if (data.totalPages <= 1) {
            pagination.innerHTML = '';
            return;
        }

        let html = `
            <li class="page-item ${!data.hasPrevious ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="goToPage(${data.pageNumber - 1}); return false;">← Назад</a>
            </li>
        `;

        // Первая страница
        if (data.pageNumber > 3) {
            html += `<li class="page-item"><a class="page-link" href="#" onclick="goToPage(1); return false;">1</a></li>`;
            if (data.pageNumber > 4) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Текущая и соседние страницы
        for (let i = Math.max(1, data.pageNumber - 2); i <= Math.min(data.totalPages, data.pageNumber + 2); i++) {
            if (i === data.pageNumber) {
                html += `<li class="page-item active"><a class="page-link" href="#">${i}</a></li>`;
            } else {
                html += `<li class="page-item"><a class="page-link" href="#" onclick="goToPage(${i}); return false;">${i}</a></li>`;
            }
        }

        // Последняя страница
        if (data.pageNumber < data.totalPages - 2) {
            if (data.pageNumber < data.totalPages - 3) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
            html += `<li class="page-item"><a class="page-link" href="#" onclick="goToPage(${data.totalPages}); return false;">${data.totalPages}</a></li>`;
        }

        html += `
            <li class="page-item ${!data.hasNext ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="goToPage(${data.pageNumber + 1}); return false;">Вперёд →</a>
            </li>
        `;

        pagination.innerHTML = html;
    }

    // Переход на страницу
    function goToPage(page) {
        pickerState.pageNumber = page;
        searchComplectations();
    }

    // Выбор комплектации
    function selectComplectation(id) {
        // Данные берём из уже загруженного списка, а не из HTML-атрибутов:
        // так выбор работает даже с длинными названиями, кавычками и переносами строк
        const item = pickerState.items.find(x => x.id === id);
        if (!item) {
            console.error('Комплектация не найдена в списке:', id);
            return;
        }

        // Устанавливаем значения в скрытый input
        document.getElementById('SelectedComplectationId').value = id;

        // Обновляем отображение выбранной комплектации
        document.getElementById('selectedComplectationNumber').textContent = item.number || '—';
        document.getElementById('selectedComplectationCustomer').textContent = item.customer || '—';
        document.getElementById('selectedComplectationDate').textContent = formatDate(item.shippingDate);
        document.getElementById('selectedComplectationManager').textContent = item.manager || '—';

        // Показываем панель выбранной комплектации, скрываем кнопку выбора
        document.getElementById('selectedComplectationDisplay').style.display = 'block';
        document.getElementById('noComplectationSelected').style.display = 'none';

        // Закрываем модальное окно
        const modal = bootstrap.Modal.getInstance(document.getElementById('complectationPickerModal'));
        if (modal) {
            modal.hide();
        }

        // Загружаем позиции комплектации
        loadComplectationPositions(id);

        console.log('Выбрана комплектация:', id, item.number);
    }

    // Экранирование HTML-символов
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text ?? '';
        return div.innerHTML
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // Форматирование даты
    function formatDate(dateStr) {
        if (!dateStr) return '—';
        const date = new Date(dateStr);
        return date.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    // Загрузка при открытии модального окна
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('complectationPickerModal');
        modal.addEventListener('shown.bs.modal', function() {
            searchComplectations();
        });
    });

    // ===== Позиции комплектации: пагинация и отправка только заполненных строк =====
    let receiptItems = [];
    let receiptState = {
        pageNumber: 1,
        pageSize: 50
    };

    // Загрузка позиций комплектации
    function loadComplectationPositions(complectationId) {
        if (!complectationId) {
            document.getElementById('lineItemsContainer').style.display = 'none';
            receiptItems = [];
            return;
        }

        // AJAX запрос для получения позиций
        fetch(`/Warehouse/GetComplectationPositions/${complectationId}`)
            .then(response => {
                if (!response.ok) throw new Error('Ошибка загрузки');
                return response.json();
            })
            .then(data => {
                // Храним все позиции в памяти, чтобы значения не терялись при переходе по страницам
                receiptItems = data.map(item => ({
                    ...item,
                    receiptQuantity: 0
                }));
                receiptState.pageNumber = 1;
                renderReceiptPage();
                document.getElementById('lineItemsContainer').style.display = 'block';
            })
            .catch(error => {
                console.error('Ошибка:', error);
                alert('Ошибка при загрузке позиций комплектации');
            });
    }

    // Отрисовка текущей страницы позиций
    function renderReceiptPage() {
        const tbody = document.getElementById('lineItemsBody');
        const pageSize = receiptState.pageSize;
        const totalPages = Math.max(1, Math.ceil(receiptItems.length / pageSize));

        if (receiptState.pageNumber > totalPages) receiptState.pageNumber = totalPages;
        if (receiptState.pageNumber < 1) receiptState.pageNumber = 1;

        const start = (receiptState.pageNumber - 1) * pageSize;
        const pageItems = receiptItems.slice(start, start + pageSize);

        if (pageItems.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Позиций нет</td>
                </tr>
            `;
        } else {
            tbody.innerHTML = pageItems
                .map((item, pageIndex) => renderReceiptRow(item, start + pageIndex))
                .join('');
        }

        renderReceiptPagination(totalPages);
        updateReceiptSummary();
    }

    // Отрисовка одной строки
    function renderReceiptRow(item, index) {
        const value = item.receiptQuantity > 0 ? item.receiptQuantity : 0;

        return `
            <tr>
                <td>${escapeHtml(item.chapter || '')}</td>
                <td>${escapeHtml(item.partName || '')}</td>
                <td class="text-center"><strong>${item.requiredQuantity}</strong></td>
                <td class="text-center bg-info text-white"><strong>${item.alreadyShipped ?? 0}</strong></td>
                <td class="text-center bg-success text-white"><strong>${item.warehouseQuantity ?? 0}</strong></td>
                <td class="text-center">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <input type="number" class="form-control form-control-sm receipt-quantity"
                            id="receiptQty_${index}"
                            value="${value}"
                            min="0" max="9999"
                            data-index="${index}"
                            style="width: 100px;" />
                        <button type="button" class="btn btn-md btn-outline-primary"
                            onclick="setRequiredQuantity(${index}, ${item.requiredQuantity})"
                            title="Заполнить требуемым количеством"
                            style="padding: 0.5rem 0.75rem; font-size: 0.95rem;">
                            <i class="fas fa-magic" style="font-size: 1.1rem;"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    }

    // Отрисовка пагинации
    function renderReceiptPagination(totalPages) {
        const pagination = document.getElementById('lineItemsPagination');
        if (!pagination) return;

        if (totalPages <= 1) {
            pagination.innerHTML = '';
            return;
        }

        const current = receiptState.pageNumber;
        const from = Math.max(1, current - 2);
        const to = Math.min(totalPages, current + 2);

        let html = `
            <li class="page-item ${current <= 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="goToReceiptPage(${current - 1}); return false;">←</a>
            </li>
        `;

        if (from > 1) {
            html += `<li class="page-item"><a class="page-link" href="#" onclick="goToReceiptPage(1); return false;">1</a></li>`;
            if (from > 2) {
                html += `<li class="page-item disabled"><span class="page-link">…</span></li>`;
            }
        }

        for (let i = from; i <= to; i++) {
            html += i === current
                ? `<li class="page-item active"><span class="page-link">${i}</span></li>`
                : `<li class="page-item"><a class="page-link" href="#" onclick="goToReceiptPage(${i}); return false;">${i}</a></li>`;
        }

        if (to < totalPages) {
            if (to < totalPages - 1) {
                html += `<li class="page-item disabled"><span class="page-link">…</span></li>`;
            }
            html += `<li class="page-item"><a class="page-link" href="#" onclick="goToReceiptPage(${totalPages}); return false;">${totalPages}</a></li>`;
        }

        html += `
            <li class="page-item ${current >= totalPages ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="goToReceiptPage(${current + 1}); return false;">→</a>
            </li>
        `;

        pagination.innerHTML = html;
    }

    function goToReceiptPage(page) {
        const totalPages = Math.max(1, Math.ceil(receiptItems.length / receiptState.pageSize));
        if (page < 1 || page > totalPages) return;

        receiptState.pageNumber = page;
        renderReceiptPage();
    }

    // Счётчики над таблицей
    function updateReceiptSummary() {
        const totalEl = document.getElementById('positionsTotal');
        const selectedEl = document.getElementById('positionsSelected');

        if (totalEl) totalEl.textContent = receiptItems.length;
        if (selectedEl) {
            selectedEl.textContent = receiptItems.filter(item => item.receiptQuantity > 0).length;
        }
    }

    // Чтение значения из input
    function handleReceiptInput(input, validate) {
        const index = parseInt(input.dataset.index, 10);
        const item = receiptItems[index];
        if (!item) return;

        let quantity = parseInt(input.value, 10);
        if (isNaN(quantity) || quantity < 0) quantity = 0;

        if (validate) input.value = quantity;
        item.receiptQuantity = quantity;
        updateReceiptSummary();
    }

    // Функция для установки требуемого количества
    function setRequiredQuantity(index, requiredQuantity) {
        const item = receiptItems[index];
        if (!item) return;

        item.receiptQuantity = requiredQuantity;
        renderReceiptPage();

        const input = document.getElementById(`receiptQty_${index}`);
        if (input) {
            input.classList.add('bg-light'); // Визуальная индикация изменения
            setTimeout(() => input.classList.remove('bg-light'), 500);
        }
    }

    // Заполнить все позиции требуемым количеством
    function fillAllReceiptQuantities() {
        receiptItems.forEach(item => {
            item.receiptQuantity = item.requiredQuantity > 0 ? item.requiredQuantity : 0;
        });

        renderReceiptPage();
    }

    // Обработчики ввода и смены размера страницы (делегирование — таблица перерисовывается)
    document.addEventListener('DOMContentLoaded', function() {
        const tbody = document.getElementById('lineItemsBody');
        if (tbody) {
            tbody.addEventListener('input', function(e) {
                if (e.target.classList.contains('receipt-quantity')) {
                    handleReceiptInput(e.target, false);
                }
            });
            tbody.addEventListener('change', function(e) {
                if (e.target.classList.contains('receipt-quantity')) {
                    handleReceiptInput(e.target, true);
                }
            });
        }

        const pageSizeSelect = document.getElementById('lineItemsPageSize');
        if (pageSizeSelect) {
            pageSizeSelect.addEventListener('change', function() {
                receiptState.pageSize = parseInt(this.value, 10) || 50;
                receiptState.pageNumber = 1;
                renderReceiptPage();
            });
        }
    });

    // Формируем скрытые поля только для позиций с количеством > 0.
    // Индексы идут подряд, поэтому модель на сервере связывается без «дыр».
    function buildReceiptPayload() {
        const payload = document.getElementById('receiptPayload');
        payload.innerHTML = '';

        const itemsToReceive = receiptItems.filter(item => item.receiptQuantity > 0);

        itemsToReceive.forEach((item, index) => {
            appendHidden(payload, `LineItems[${index}].PositionId`, item.positionId);
            appendHidden(payload, `LineItems[${index}].PartId`, item.partId);
            appendHidden(payload, `LineItems[${index}].ReceiptQuantity`, item.receiptQuantity);
        });

        return itemsToReceive.length;
    }

    function appendHidden(container, name, value) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        input.value = value;
        container.appendChild(input);
    }

    // Обработка submit формы
    document.getElementById('receiptForm').addEventListener('submit', function(e) {
        e.preventDefault();

        // Если пользователь отправил форму прямо из поля ввода — фиксируем значение
        const active = document.activeElement;
        if (active && active.classList && active.classList.contains('receipt-quantity')) {
            handleReceiptInput(active, true);
        }

        if (buildReceiptPayload() === 0) {
            alert('Укажите количество хотя бы для одной позиции!');
            return;
        }

        this.submit();
    });

</script>

