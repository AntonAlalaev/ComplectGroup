@model List<WarehouseItemDto>

@{
    ViewData["Title"] = "Склад деталей";
    var pagination = ViewBag.Pagination as ComplectGroup.Web.Models.PaginationInfo;
    var pageSizes = new[] { 25, 50, 100, 200 };
}

<div class="container mt-4">
    <!-- Заголовок страницы -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h1>📦 Склад деталей</h1>
        </div>
    </div>

    <!-- Кнопки управления - Основные действия -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a asp-action="Receipt" class="btn btn-success">
                    <i class="bi bi-arrow-down"></i> Приходование
                </a>
                <a asp-action="ReceiptByComplectation" class="btn btn-success">
                    <i class="bi bi-box-seam"></i> Приход по комплектации
                </a>
                <a asp-action="Ship" class="btn btn-primary">
                    <i class="bi bi-arrow-up"></i> Отгрузка
                </a>
                <a asp-action="ShipByComplectation" class="btn btn-primary">
                    <i class="bi bi-box-seam"></i> Отгрузка по комплектации
                </a>
                <a asp-action="Correction" class="btn btn-warning">
                    <i class="bi bi-arrow-left-right"></i> Корректировка пересортицы
                </a>
            </div>
            
            <!-- Разделитель -->
            <div class="border-top pt-2 mb-3"></div>
            
            <!-- Кнопки истории -->
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="ReceiptHistory" class="btn btn-outline-info">
                    <i class="bi bi-clock-history"></i>📦➡️История приёмок
                </a>
                <a asp-action="ShippingHistory" class="btn btn-outline-info">
                    <i class="bi bi-clock-history"></i> История отгрузок🚛
                </a>
                <a asp-action="CorrectionHistory" class="btn btn-outline-warning">
                    <i class="bi bi-clock-history"></i> История корректировок🔄
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model?.Any() == true)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="text-muted small">
                Всего товаров на складе: <strong>@(pagination?.TotalItems ?? Model.Count)</strong>
                @if (pagination != null && pagination.TotalPages > 1)
                {
                    <span>· Страница @pagination.CurrentPage из @pagination.TotalPages</span>
                }
            </div>
            @if (pagination != null)
            {
                <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                    <label for="pageSize" class="form-label mb-0 small text-muted">На странице</label>
                    <select id="pageSize" name="pageSize" class="form-select form-select-sm"
                            style="width: auto;" onchange="this.form.submit()">
                        @foreach (var size in pageSizes)
                        {
                            <option value="@size" selected="@(pagination.PageSize == size)">@size</option>
                        }
                    </select>
                </form>
            }
        </div>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Раздел</th>
                    <th>Деталь</th>
                    <th class="text-center">Доступно</th>
                    <th class="text-center">Зарезервировано</th>
                    <th class="text-center">Всего</th>
                    <th>Последнее изменение</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Part.Chapter.Name</td>
                        <td>@item.Part.Name</td>
                        <td class="text-center"><span class="badge bg-success">@item.AvailableQuantity</span></td>
                        <td class="text-center"><span class="badge bg-warning">@item.ReservedQuantity</span></td>
                        <td class="text-center"><strong>@item.TotalQuantity</strong></td>
                        <td>@item.LastModifiedDate.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (pagination != null && pagination.TotalPages > 1)
        {
            var startPage = Math.Max(1, pagination.CurrentPage - 2);
            var endPage = Math.Min(pagination.TotalPages, pagination.CurrentPage + 2);

            <nav aria-label="Пагинация склада" class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(pagination.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@(pagination.CurrentPage - 1)"
                           asp-route-pageSize="@pagination.PageSize">← Назад</a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-pageSize="@pagination.PageSize">1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (var i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == pagination.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@i"
                               asp-route-pageSize="@pagination.PageSize">@i</a>
                        </li>
                    }

                    @if (endPage < pagination.TotalPages)
                    {
                        if (endPage < pagination.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@pagination.TotalPages" asp-route-pageSize="@pagination.PageSize">@pagination.TotalPages</a>
                        </li>
                    }

                    <li class="page-item @(pagination.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@(pagination.CurrentPage + 1)"
                           asp-route-pageSize="@pagination.PageSize">Вперёд →</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info">
            На складе нет товаров. <a asp-action="Receipt">Добавить товар</a>
        </div>
    }

    <!-- УДАЛЕН НИЖНИЙ БЛОК С КНОПКАМИ, ТАК КАК ОНИ ТЕПЕРЬ В ВЕРХУ -->
</div>

<style>
    /* Стили для улучшения внешнего вида кнопок */
    .btn {
        min-width: 120px;
    }
    
    .btn-outline-info {
        border-width: 2px;
    }
    
    /* Адаптивность для мобильных устройств */
    @@media (max-width: 768px) {
        .d-flex {
            justify-content: center !important;
        }
        
        .btn {
            flex: 1 0 auto;
            min-width: 0;
            margin-bottom: 5px;
        }
    }
</style>