@model ComplectGroup.Web.Models.PartRouteViewModel
@{
    ViewData["Title"] = "Маршрут детали";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h1>📋 Маршрут: @Model.Part.Name</h1>
            <p class="text-muted">Раздел: @Model.Part.Chapter.Name · Всего: @Model.Operations.Count операций, @Model.TotalPlannedHours.ToString("0.###") нормо-часов</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="CreatePartOperation" asp-route-partId="@Model.Part.Id" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Добавить операцию
            </a>
            <a asp-action="PartOperations" class="btn btn-secondary">Назад</a>
        </div>
    </div>

    @if (Model.Operations == null || Model.Operations.Count == 0)
    {
        <div class="alert alert-info">
            Маршрут не задан. <a asp-action="CreatePartOperation" asp-route-partId="@Model.Part.Id">Добавьте первую операцию</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>№</th>
                        <th>Тип операции</th>
                        <th>Бригада</th>
                        <th>Нормо-часы</th>
                        <th>Примечание</th>
                        <th>Активна</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var operation in Model.Operations.OrderBy(o => o.SequenceNumber))
                    {
                        <tr>
                            <td>@operation.SequenceNumber</td>
                            <td>@operation.OperationTypeCode — @operation.OperationTypeName</td>
                            <td>@operation.BrigadeName</td>
                            <td>@operation.PlannedLaborHours.ToString("0.###")</td>
                            <td>@(string.IsNullOrWhiteSpace(operation.Notes) ? "-" : operation.Notes)</td>
                            <td>
                                @if (operation.IsActive)
                                {
                                    <span class="badge bg-success">Да</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Нет</span>
                                }
                            </td>
                            <td>
                                <a asp-action="EditPartOperation" asp-route-id="@operation.Id"
                                   class="btn btn-sm btn-warning">Редактировать</a>
                                <form method="post" asp-action="DeletePartOperation" style="display:inline;"
                                      onsubmit="return confirm('Удалить операцию из маршрута?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@operation.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
