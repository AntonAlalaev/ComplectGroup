@model ComplectGroup.Web.Models.OperationTypeFormViewModel
@{
    ViewData["Title"] = Model.Id > 0 ? "Редактировать тип операции" : "Создать тип операции";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h1>@(Model.Id > 0 ? "Редактировать тип операции" : "Создать тип операции")</h1>

            <form asp-action="@(Model.Id > 0 ? "EditOperationType" : "CreateOperationType")" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label asp-for="Code" class="form-label">Код операции *</label>
                    <input asp-for="Code" class="form-control" placeholder="Например: WELD" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                    <small class="text-muted">Уникальный код (резка, гибка, сварка, покраска, упаковка и т.д.)</small>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label">Название операции *</label>
                    <input asp-for="Name" class="form-control" placeholder="Например: Сварка" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">Сохранить</button>
                    <a asp-action="OperationTypes" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
