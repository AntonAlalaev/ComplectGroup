@model List<ComplectGroup.Application.DTOs.BrigadeDto>
@{
    ViewData["Title"] = "Бригады";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h1>👥 Бригады</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="CreateBrigade" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Добавить бригаду
            </a>
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Нет добавленных бригад. <a asp-action="CreateBrigade">Создайте новую бригаду</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Название</th>
                        <th>Описание</th>
                        <th>Активна</th>
                        <th>Операций</th>
                        <th>Нормо-часы</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var brigade in Model)
                    {
                        <tr>
                            <td>@brigade.Id</td>
                            <td>@brigade.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(brigade.Description) ? "-" : brigade.Description)</td>
                            <td>
                                @if (brigade.IsActive)
                                {
                                    <span class="badge bg-success">Да</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Нет</span>
                                }
                            </td>
                            <td>@brigade.OperationsCount</td>
                            <td>@brigade.TotalPlannedHours.ToString("0.###")</td>
                            <td>
                                <a asp-action="EditBrigade" asp-route-id="@brigade.Id"
                                   class="btn btn-sm btn-warning">Редактировать</a>
                                <form method="post" asp-action="DeleteBrigade" style="display:inline;"
                                      onsubmit="return confirm('Удалить бригаду?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@brigade.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
