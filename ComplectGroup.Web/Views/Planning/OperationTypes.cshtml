@model List<ComplectGroup.Application.DTOs.OperationTypeDto>
@{
    ViewData["Title"] = "Типы операций";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h1>🔧 Типы операций</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="CreateOperationType" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Добавить тип операции
            </a>
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Нет добавленных типов операций. <a asp-action="CreateOperationType">Создайте новый тип</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Код</th>
                        <th>Название</th>
                        <th>Операций</th>
                        <th>Нормо-часы</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var operationType in Model)
                    {
                        <tr>
                            <td>@operationType.Id</td>
                            <td><code>@operationType.Code</code></td>
                            <td>@operationType.Name</td>
                            <td>@operationType.OperationsCount</td>
                            <td>@operationType.TotalPlannedHours.ToString("0.###")</td>
                            <td>
                                <a asp-action="EditOperationType" asp-route-id="@operationType.Id"
                                   class="btn btn-sm btn-warning">Редактировать</a>
                                <form method="post" asp-action="DeleteOperationType" style="display:inline;"
                                      onsubmit="return confirm('Удалить тип операции?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@operationType.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
