@model List<ComplectGroup.Application.DTOs.ProductionPlanDto>
@{
    ViewData["Title"] = "Производственные планы";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h1>📅 Производственные планы</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Создать план
            </a>
            <a asp-action="Workload" class="btn btn-info">Трудоёмкость по бригадам</a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Нет созданных планов. <a asp-action="Create">Создайте новый план</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Период</th>
                        <th>Статус</th>
                        <th>Позиций</th>
                        <th>Операций</th>
                        <th>Выполнено</th>
                        <th>Нормо-часы</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in Model)
                    {
                        <tr>
                            <td>@plan.Id</td>
                            <td>@plan.PeriodStart.ToString("dd.MM.yyyy") – @plan.PeriodEnd.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="badge bg-secondary">@plan.Status</span>
                            </td>
                            <td>@plan.Items.Count</td>
                            <td>@plan.TotalOperations</td>
                            <td>@plan.CompletedOperations / @plan.TotalOperations</td>
                            <td>@plan.TotalPlannedHours.ToString("0.###")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@plan.Id" class="btn btn-sm btn-primary">Открыть</a>
                                <a asp-action="Consolidated" asp-route-id="@plan.Id" class="btn btn-sm btn-info">Сводный</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
