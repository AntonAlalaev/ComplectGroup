@{
    ViewData["Title"] = "Создать производственный план";
    var periodStart = ViewBag.PeriodStart as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var periodEnd = ViewBag.PeriodEnd as string ?? DateTime.Today.AddDays(6).ToString("yyyy-MM-dd");
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h1>Создать производственный план</h1>

            <form asp-action="Create" method="post">
                <div class="form-group mb-3">
                    <label class="form-label">Начало периода *</label>
                    <input type="date" name="periodStart" value="@periodStart" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Конец периода *</label>
                    <input type="date" name="periodEnd" value="@periodEnd" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Примечания</label>
                    <textarea name="notes" class="form-control" rows="3">@ViewBag.Notes</textarea>
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" name="allowOverlap" value="true" class="form-check-input"
                           checked="@(ViewBag.AllowOverlap == true)" />
                    <label class="form-check-label">Разрешить пересечение с другими активными планами</label>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">Создать</button>
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
